{
  "name": "ops-mcp",
  "version": "1.0.0",
  "description": "A governed MCP server for an operations office: scoped tools over synthetic HR, vendor and portfolio data, field-level redaction, audit log, OAuth-protected HTTP, plus a validated Claude Skill",
  "scripts": {
    "start:stdio": "tsx src/stdio.ts",
    "start:http": "tsx src/http.ts",
    "dev-token": "tsx scripts/dev-token.ts",
    "validate-skills": "tsx scripts/validate-skills.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && tsx scripts/validate-skills.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "author": "Taner Acar",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
